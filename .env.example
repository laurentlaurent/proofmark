# Copy to .env and fill in ONE provider. Without any key, Proofmark runs in demo mode.
# Everything here can also be changed in the app (Model button, top right).

# Google Gemini, free tier: https://aistudio.google.com/apikey  (reads screenshots)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Groq, free tier: https://console.groq.com/keys  (text only)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Ollama, local and free: https://ollama.com  then `ollama pull llama3.1`
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# Any other OpenAI-compatible API (OpenRouter, LM Studio, Mistral, OpenAI...)
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# Optional
# PROOFMARK_PROVIDER=gemini      # demo | gemini | groq | ollama | custom (default: first key found, else demo)
# PROOFMARK_VISION=true          # force image support on or off for the chosen model
# PROOFMARK_PORT=8000
# PROOFMARK_TIMEOUT=120          # seconds per model call
# PROOFMARK_KB_DIR=knowledge_base
