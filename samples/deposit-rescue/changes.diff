 export function onPaymentResult(result: PaymentResult, ctx: DepositContext) {
   if (result.status === 'success') {
     return showSuccess(ctx.amount);
   }
-  return showError('Payment failed. Please try again.');
+  if (result.status === 'declined' && ctx.method === 'card' && flags.deposit_rescue_enabled) {
